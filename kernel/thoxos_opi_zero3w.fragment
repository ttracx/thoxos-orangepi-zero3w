#
# Merge fragment for Linux 6.6.98 (orange-pi-6.6-sun60iw2).
# Not a defconfig. Merge onto linux-sun60iw2-current-a733.config.
# See README.md and FRAGMENT-NOTES.md.
#
# CONFIG_MD is required: the vendor A733 config has
# "# CONFIG_MD is not set", and BLK_DEV_DM depends on it.
# DRM is intentionally not unset. CONFIG_LOGO is.

CONFIG_LOCALVERSION="-thoxos"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y
CONFIG_WIREGUARD=m
CONFIG_INET_ESP=m
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_GADGET=y
CONFIG_USB_ACM=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_LOGO=n
